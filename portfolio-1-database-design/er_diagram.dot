digraph ER {
 graph [rankdir=LR, fontname="Helvetica", nodesep=0.35, ranksep=1.0, pad=0.3];
 node [shape=plain, fontname="Helvetica", fontsize=10];
 edge [fontname="Helvetica", fontsize=9, color="#555555", dir=both, arrowhead=tee, arrowtail=crow];
 customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>PK</B> customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">    full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">    email</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code">    country_code</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="loyalty_tier">    loyalty_tier</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">    created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id"><B>PK</B> order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">FK customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date">    order_date</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">    status</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="shipping_country">    shipping_country</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount">    total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">numeric</FONT></TD></TR></TABLE>>];
 order_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_item_id"><B>PK</B> order_item_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">FK order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="variant_id">FK variant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">    quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">    unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">numeric</FONT></TD></TR></TABLE>>];
 payments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><B>PK</B> payment_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">FK order_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount">    amount</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="method">    method</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_status">    payment_status</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at">    paid_at</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 fittings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>fittings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fitting_id"><B>PK</B> fitting_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_item_id">FK order_item_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="scheduled_at">    scheduled_at</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stylist_name">    stylist_name</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="outcome">    outcome</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR></TABLE>>];
 variants [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>variants</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="variant_id"><B>PK</B> variant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">FK product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size_label">    size_label</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="colour">    colour</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_qty">    stock_qty</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">int</FONT></TD></TR></TABLE>>];
 products [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>PK</B> product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="collection_id">FK collection_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sku">    sku</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_name">    product_name</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category">    category</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="base_price">    base_price</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="made_to_order">    made_to_order</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bool</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lead_time_days">    lead_time_days</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="active">    active</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bool</FONT></TD></TR></TABLE>>];
 collections [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>collections</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="collection_id"><B>PK</B> collection_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="collection_name">    collection_name</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season">    season</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="collection_year">    collection_year</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">smallint</FONT></TD></TR></TABLE>>];
 stock_movements [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>stock_movements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_id"><B>PK</B> movement_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="variant_id">FK variant_id</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="delta">    delta</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reason">    reason</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">    created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
 products -> collections [label="collection_id"];
 variants -> products [label="product_id"];
 orders -> customers [label="customer_id"];
 order_items -> orders [label="order_id"];
 order_items -> variants [label="variant_id"];
 payments -> orders [label="order_id"];
 fittings -> order_items [label="order_item_id"];
 stock_movements -> variants [label="variant_id"];
}